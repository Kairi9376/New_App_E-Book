# ======================================================================
# Template for the Docker Compose .env file at the repo root.
# Copy to `.env` and fill in real values before running `docker compose up`.
#
#   cp .env.example .env
#
# Both variables are REQUIRED - Compose substitutes a blank string when
# they are missing, and MySQL 8 refuses to initialize with a blank root
# password, which takes the backend and phpMyAdmin down with it.
# ======================================================================

# MySQL root password - used by the mysql service and by the backend's
# DB_PASSWORD. Changing this after the first `up` requires removing the
# mysql-data volume, because the password is baked in at DB init time.
MYSQL_ROOT_PASSWORD=

# Signing secret for JWTs issued by the backend. Rotating it invalidates
# every token already handed out.
JWT_SECRET=
PORT=5000
PUBLIC_BASE_URL=http://localhost:5001
