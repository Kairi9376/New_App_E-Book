<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- # ເຮັດຫຍັງ: ເພີ່ມສິດ network.client ຄືກັນກັບ DebugProfile.entitlements
	     # ຍ້ອນຫຍັງ: ຖ້າໃສ່ແຕ່ຝັ່ງ Debug ຕອນ build release ແອັບຈະຕໍ່ backend ບໍ່ໄດ້
	     #          ແລ້ວກາຍເປັນ bug ທີ່ພົບຕອນ build ສົ່ງມອບເທົ່ານັ້ນ ຫາສາເຫດຍາກ
	     # ແກ້ຈາກສ່ວນໃດ: ໄຟລ໌ນີ້ມີແຕ່ app-sandbox ຢ່າງດຽວ
	     # ແກ້ເຮັດຫຍັງ: ໃຫ້ build release ຕໍ່ backend ໄດ້ຄືກັນກັບ debug -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- # ເຮັດຫຍັງ: ເພີ່ມສິດອ່ານໄຟລ໌ທີ່ຜູ້ໃຊ້ເລືອກ ຄືກັນກັບ DebugProfile.entitlements
	     # ຍ້ອນຫຍັງ: ຖ້າໃສ່ແຕ່ຝັ່ງ Debug ການອັບໂຫຼດຈະພັງສະເພາະ build release
	     # ແກ້ຈາກສ່ວນໃດ: ໄຟລ໌ນີ້ຍັງບໍ່ມີສິດກ່ຽວກັບໄຟລ໌ເລີຍ
	     # ແກ້ເຮັດຫຍັງ: ໃຫ້ອັບໂຫຼດໄຟລ໌ໃນ build release ໄດ້ຄືກັນກັບ debug -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
